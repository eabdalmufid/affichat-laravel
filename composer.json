{
  "name": "affidev/affichat",
  "description": "Official WhatsApp Notification Channel and PHP Client for AffiChat Gateway",
  "keywords": [
    "laravel",
    "whatsapp",
    "notification",
    "affichat",
    "channel"
  ],
  "homepage": "https://chat.affidev.com",
  "license": "MIT",
  "authors": [
    {
      "name": "AffiChat Team",
      "homepage": "https://chat.affidev.com"
    }
  ],
  "require": {
    "php": "^8.0 || ^8.1 || ^8.2 || ^8.3",
    "illuminate/notifications": "^9.0 || ^10.0 || ^11.0 || ^12.0",
    "illuminate/support": "^9.0 || ^10.0 || ^11.0 || ^12.0",
    "guzzlehttp/guzzle": "^7.2"
  },
  "autoload": {
    "psr-4": {
      "AffiChat\\Laravel\\": "src/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "AffiChat\\Laravel\\AffiChatServiceProvider"
      ],
      "aliases": {
        "AffiChat": "AffiChat\\Laravel\\Facades\\AffiChat"
      }
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
